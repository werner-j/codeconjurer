<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension
         point="org.eclipse.ui.views">
      <category
            id="de.uni_mannheim.swt.codeconjurer"
            name="%code_conjurer.name">
      </category>
      <view
            allowMultiple="false"
            category="de.uni_mannheim.swt.codeconjurer"
            class="de.uni_mannheim.swt.codeconjurer.ui.view.ResultView"
            icon="icons/code_conjurer_m.png"
            id="de.uni_mannheim.swt.codeconjurer.views.ResultView"
            name="%reuse_view.name"
            restorable="true">
      </view>
   </extension>
   <extension
         id="de.uni_mannheim.swt.codeconjurer"
         point="org.eclipse.ui.actionSets">
      <actionSet
            description="%cc_activate.description"
            id="de.uni_mannheim.swt.codeconjurer.actionSet"
            label="%cc_activate.label"
            visible="true">
         <menu
               id="reuseMenu"
               label="%merobase_menu.label">
            <groupMarker
                  name="techGroup">
            </groupMarker>
            <groupMarker
                  name="uiGroup">
            </groupMarker>
            <separator
                  name="searchGroup">
            </separator>
         </menu>
         <action
               class="de.uni_mannheim.swt.codeconjurer.ui.controller.ActivatorButton"
               icon="icons/code_conjurer_m.png"
               id="de.uni_mannheim.swt.codeconjurer.UseAgentAction"
               label="%use_agent.label"
               menubarPath="reuseMenu/techGroup"
               state="false"
               style="toggle"
               toolbarPath="techGroup"
               tooltip="%reuse_agent.tooltip">
         </action>
         <action
               class="de.uni_mannheim.swt.codeconjurer.ui.controller.PerformSearch"
               id="de.uni_mannheim.swt.codeconjurer.SearchAction"
               label="%search_code.label"
               menubarPath="reuseMenu/searchGroup"
               style="push">
         </action>
         <action
               class="de.uni_mannheim.swt.codeconjurer.ui.controller.ShowReuseView"
               id="de.uni_mannheim.swt.codeconjurer.ShowRecommendationsViewAction"
               label="%show_recommendations_view.label"
               menubarPath="reuseMenu/uiGroup"
               tooltip="%show_recommendations_view.tooltip">
         </action>
      </actionSet>
   </extension>
   <extension
         point="org.eclipse.ui.perspectiveExtensions">
      <perspectiveExtension
            targetID="org.eclipse.jdt.ui.JavaPerspective">
         <viewShortcut
               id="de.uni_mannheim.swt.codeconjurer.views.ResultView">
         </viewShortcut>
         <view
               closeable="true"
               id="de.uni_mannheim.swt.codeconjurer.views.ResultView"
               minimized="false"
               relationship="stack"
               relative="org.eclipse.pde.runtime.LogView"
               showTitle="true"
               standalone="false"
               visible="true">
         </view>
      </perspectiveExtension>
   </extension>
   <extension
         point="org.eclipse.ui.preferencePages">
      <page
            class="de.uni_mannheim.swt.codeconjurer.ui.preferences.CodeConjurerPreferences"
            id="de.uni_mannheim.swt.codeconjurer.preferences.CodeConjurerPreferences"
            name="%page.name">
      </page>
      <page
            category="de.uni_mannheim.swt.codeconjurer.preferences.CodeConjurerPreferences"
            class="de.uni_mannheim.swt.codeconjurer.ui.preferences.CodeManipulationPreferences"
            id="de.uni_mannheim.swt.codeconjurer.preferences.CodeManipulationPreferences"
            name="%manipulation.name">
      </page>
      <page
            category="de.uni_mannheim.swt.codeconjurer.preferences.CodeConjurerPreferences"
            class="de.uni_mannheim.swt.codeconjurer.ui.preferences.PrivacyPreferences"
            id="de.uni_mannheim.swt.codeconjurer.preferences.PrivacyPreferences"
            name="%privacy_prefs.name">
      </page>
   </extension>
   <extension
         id="de.uni_mannheim.swt.codeconjurer.preferences.Preferences"
         point="org.eclipse.core.runtime.preferences">
      <initializer
            class="de.uni_mannheim.swt.codeconjurer.domain.preferences.PreferenceInitializer">
      </initializer>
   </extension>
   <extension
         point="org.eclipse.ui.dropActions">
      <action
            class="de.uni_mannheim.swt.codeconjurer.ui.dnd.PluginDropActionDelegate"
            id="de.uni_mannheim.swt.codeconjurer.ui.dnd.pluginDropAction">
      </action>
   </extension>
   <extension
         point="org.eclipse.ui.viewActions">
      <viewContribution
            id="de.uni_mannheim.swt.codeconjurer.viewContribution.ResultView"
            targetID="de.uni_mannheim.swt.codeconjurer.views.ResultView">
         <menu
               id="de.uni_mannheim.swt.codeconjurer.views.ResultView.menu"
               label="%merobase_menu.label">
         </menu>
         <action
               class="de.uni_mannheim.swt.codeconjurer.ui.view.elements.actions.PerformSearchFromViewAction"
               icon="icons/code_conjurer_m.png"
               id="de.uni_mannheim.swt.codeconjurer.action2"
               label="%search.label"
               mode="FORCE_TEXT"
               style="push"
               toolbarPath="de.uni_mannheim.swt.codeconjurer.views.ResultView.toolbar">
         </action>
         <action
               class="de.uni_mannheim.swt.codeconjurer.ui.view.elements.actions.RefreshAction"
               icon="icons/refresh.png"
               id="de.uni_mannheim.swt.codeconjurer.action3"
               label="%refresh.label"
               style="push"
               toolbarPath="de.uni_mannheim.swt.codeconjurer.views.ResultView.toolbar"
               tooltip="Refresh the result tree">
         </action>
         <action
               class="de.uni_mannheim.swt.codeconjurer.ui.view.elements.actions.ShowAdapterAction"
               icon="icons/adapter.gif"
               id="de.uni_mannheim.swt.codeconjurer.showAdapterAction"
               label="%show_adapter.label"
               menubarPath="de.uni_mannheim.swt.codeconjurer.views.ResultView.menu"
               style="toggle"
               toolbarPath="de.uni_mannheim.swt.codeconjurer.views.ResultView.toolbar"
               tooltip="%show_adapter.tooltip">
         </action>
      </viewContribution>
   </extension>

</plugin>
